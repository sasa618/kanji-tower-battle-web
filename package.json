{
  "name": "kanji-tower-battle-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "dev:api": "wrangler dev --env dev --local --port 8787",
    "glyphs": "node tools/build-glyphs.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "tsx --test tests/*.test.ts",
    "verify:physics": "tsx tools/verify-physics.ts",
    "deploy:worker": "node tools/deploy-worker.mjs",
    "check:release": "node tools/check-release.mjs"
  },
  "dependencies": {
    "planck": "1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22.18.0",
    "earcut": "^3.0.2",
    "opentype.js": "^1.3.4",
    "polygon-clipping": "^0.15.7",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.151.1"
  }
}
