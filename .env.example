# ビルド時に埋め込まれる公開値である．秘密情報は VITE_* に入れない．
# コピーして .env.production.local（本番ビルド用）や .env.development.local（npm run dev 用）を作る．
# これらのローカルファイルは .gitignore で除外される．

# Worker（全国ランキング・共有リンク）の URL．末尾のスラッシュは付けない．
# 空のままにすると，画面には「接続準備中」と表示され，ゲームと端末内の記録だけが使える．
VITE_RANKING_API=https://kanji-tower-battle-ranking.<アカウントのサブドメイン>.workers.dev

# 公開したゲームの URL．X への投稿と OGP（固定カード）の絶対 URL に使う．末尾のスラッシュを付ける．
# 空のままにすると，OGP の絶対 URL のメタタグは出力されず，投稿にも URL を含めない．
VITE_PUBLIC_URL=https://sasa618.github.io/kanji-tower-battle-web/

# 以下は任意の計測用で，どちらも公開値である．未設定ならタグは出力されない．
# Cloudflare Web Analytics の beacon token（ダッシュボード → Web Analytics → サイトを追加 → スニペットの token，32桁の16進数）．
VITE_CF_BEACON_TOKEN=
# Google Search Console の所有確認コード（URL プレフィックス プロパティ → HTML タグ → content の値）．
VITE_GOOGLE_SITE_VERIFICATION=
